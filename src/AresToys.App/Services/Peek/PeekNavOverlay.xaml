<Window x:Class="AresToys.App.Services.Peek.PeekNavOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False"
        Focusable="False">
    <!-- Covers the preview area of Peek. Its transparent pixels let the mouse through to the preview below;
         only the two chevrons take clicks, and they never take the focus from Peek. -->
    <Grid Background="Transparent">
        <ui:Button x:Name="PrevButton" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="12,0,0,0" Width="40" Height="72" Padding="0"
                   Focusable="False" Opacity="0" IsHitTestVisible="False"
                   Icon="{ui:SymbolIcon ChevronLeft24}" Click="OnPrevClick" />
        <ui:Button x:Name="NextButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Margin="0,0,12,0" Width="40" Height="72" Padding="0"
                   Focusable="False" Opacity="0" IsHitTestVisible="False"
                   Icon="{ui:SymbolIcon ChevronRight24}" Click="OnNextClick" />
    </Grid>
</Window>
