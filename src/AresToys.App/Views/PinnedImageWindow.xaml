<Window x:Class="AresToys.App.Views.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:Markup="clr-namespace:AresToys.App.Markup"
        Title="AresToys pin"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <!-- Near-transparent window background: a PNG's transparent areas show what's behind the
         pin, while the alpha of 1 keeps them clickable (fully transparent pixels of a layered
         window let the mouse fall through). -->
    <Grid x:Name="RootGrid"
          MouseEnter="OnRootMouseEnter"
          MouseLeave="OnRootMouseLeave">
        <Border x:Name="ImageBorder"
                BorderThickness="0"
                BorderBrush="{DynamicResource AccentBackgroundBrush}"
                Padding="0">
            <Image x:Name="PinnedImage"
                   Stretch="Uniform"
                   MouseLeftButtonDown="OnImageMouseDown"
                   MouseRightButtonUp="OnImageRightClick"
                   MouseWheel="OnImageWheel" />
        </Border>
        <!-- Hover-revealed overlay with copy + zoom %. Sits at top-center, unobtrusive. -->
        <Border x:Name="OverlayBar"
                Visibility="Collapsed"
                Background="#CC1F1F1F"
                CornerRadius="4"
                Padding="6,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="CopyButton"
                        Content="📋"
                        FontSize="13"
                        Padding="4,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc PinnedImage_CopyTooltip}"
                        Click="OnCopyClick" />
                <Button x:Name="SaveButton"
                        Content="💾"
                        FontSize="13"
                        Padding="4,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc PinnedImage_SaveTooltip}"
                        Click="OnSaveClick" />
                <Button x:Name="EditButton"
                        Content="✏"
                        FontSize="13"
                        Padding="4,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc PinnedImage_OpenEditorTooltip}"
                        Click="OnEditClick" />
                <Button x:Name="ResetZoomButton"
                        Content="🔍"
                        FontSize="13"
                        Padding="4,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc PinnedImage_ResetZoomTooltip}"
                        Click="OnResetZoomClick" />
                <TextBlock x:Name="ZoomLabel"
                           Text="100%"
                           Foreground="{DynamicResource AccentForegroundBrush}"
                           FontSize="11"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"
                           Background="Transparent"
                           Cursor="Hand"
                           ToolTip="{Markup:Loc PinnedImage_ZoomTooltip}"
                           MouseWheel="OnZoomLabelWheel"
                           MouseLeftButtonUp="OnZoomLabelClick" />
                <!-- Opacity readout: scroll over it (or Shift+wheel on the pin) to change it, click
                     resets to 100%. Transparent background so the whole box takes the wheel. -->
                <TextBlock x:Name="OpacityLabel"
                           Text="◐ 100%"
                           Foreground="{DynamicResource AccentForegroundBrush}"
                           FontSize="11"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Margin="10,0,2,0"
                           Background="Transparent"
                           Cursor="Hand"
                           MouseWheel="OnOpacityLabelWheel"
                           ToolTip="{Markup:Loc PinnedImage_OpacityTooltip}"
                           MouseLeftButtonUp="OnOpacityLabelClick" />
                <!-- Lock: no move, no resize, no accidental close until clicked again. -->
                <Button x:Name="LockButton"
                        Content="🔓"
                        FontSize="13"
                        Padding="4,0"
                        Margin="4,0,0,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc PinnedImage_LockTooltip}"
                        Click="OnLockClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
