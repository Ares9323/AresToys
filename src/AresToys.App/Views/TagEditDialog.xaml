<ui:FluentWindow x:Class="AresToys.App.Views.TagEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:Markup="clr-namespace:AresToys.App.Markup"
        WindowStartupLocation="CenterOwner"
        Title="AresToys"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource Surface2Brush}"
        ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <!-- Colour swatch: a round RadioButton (one group, so picking one clears the rest).
             The swatch colour comes in through Background; the checked state draws an accent
             ring around it. The "no colour" swatch uses the neutral surface plus a slash. -->
        <Style x:Key="SwatchRadio" TargetType="RadioButton">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="TagColor" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}"
                                     Stroke="{DynamicResource InnerBorderBrush}" StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Border Background="{DynamicResource Surface2Brush}"
            BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="2" CornerRadius="8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
        <StackPanel Grid.Row="1" Margin="20">
            <TextBlock Text="{Markup:Loc TagDialog_NameLabel}" Foreground="{DynamicResource AccentForegroundBrush}"
                       FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" FontSize="13" Margin="0,0,0,4" MaxLength="40" TextChanged="OnNameChanged" />
            <TextBlock x:Name="ErrorText" Text="{Markup:Loc TagDialog_NameTaken}"
                       Foreground="#E5484D" FontSize="11" Margin="0,0,0,4" Visibility="Collapsed" />
            <TextBlock Text="{Markup:Loc TagDialog_ColorLabel}" Foreground="{DynamicResource AccentForegroundBrush}"
                       FontSize="12" Margin="0,8,0,6" />
            <!-- Filled from code-behind: the neutral swatch first, then the palette, then the
                 tag's current colour when it isn't one of the presets (e.g. from a backup). -->
            <WrapPanel x:Name="SwatchPanel" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <ui:Button x:Name="OkButton" Content="{Markup:Loc Common_Ok}" Padding="14,4" Margin="0,0,8,0"
                           Appearance="Primary" IsDefault="True" Click="OnOkClicked" />
                <ui:Button Content="{Markup:Loc Common_Cancel}" Padding="14,4" IsCancel="True" Click="OnCancelClicked" />
            </StackPanel>
        </StackPanel>
    </Grid>
    </Border>
</ui:FluentWindow>
