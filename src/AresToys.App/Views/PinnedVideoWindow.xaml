<Window x:Class="AresToys.App.Views.PinnedVideoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Markup="clr-namespace:AresToys.App.Markup"
        Title="AresToys pin"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Black"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <!-- Video / animated GIF counterpart of PinnedImageWindow: same chrome (borderless,
         topmost, accent border, hover overlay), plus a looping MediaElement and a bottom
         transport bar. The MediaElement streams from disk, so even a huge recording is never
         decoded into memory as a whole. -->
    <Grid x:Name="RootGrid"
          MouseEnter="OnRootMouseEnter"
          MouseLeave="OnRootMouseLeave">
        <Border x:Name="VideoBorder"
                BorderThickness="0"
                BorderBrush="{DynamicResource AccentBackgroundBrush}"
                Padding="0">
            <!-- Transparent background so the whole surface (letterbox included) takes the
                 drag / click / wheel input, not only the decoded frame. -->
            <Grid Background="Transparent"
                  MouseLeftButtonDown="OnSurfaceMouseDown"
                  MouseRightButtonUp="OnSurfaceRightClick"
                  MouseWheel="OnSurfaceWheel">
                <MediaElement x:Name="Player"
                              LoadedBehavior="Manual"
                              UnloadedBehavior="Close"
                              Stretch="Uniform"
                              ScrubbingEnabled="True"
                              MediaOpened="OnMediaOpened"
                              MediaEnded="OnMediaEnded"
                              MediaFailed="OnMediaFailed" />
            </Grid>
        </Border>
        <!-- Hover-revealed zoom readout, top-center like the image pin. -->
        <Border x:Name="TopBar"
                Visibility="Collapsed"
                Background="#CC1F1F1F"
                CornerRadius="4"
                Padding="6,3"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,6,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="🔍"
                        FontSize="13"
                        Padding="4,0"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc PinnedImage_ResetZoomTooltip}"
                        Click="OnResetZoomClick" />
                <TextBlock x:Name="ZoomLabel"
                           Text="100%"
                           Foreground="{DynamicResource AccentForegroundBrush}"
                           FontSize="11"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Margin="2,0,0,0"
                           ToolTip="{Markup:Loc PinnedVideo_ControlsHint}" />
                <!-- Opacity readout: Shift+wheel changes it, click resets to 100%. -->
                <TextBlock x:Name="OpacityLabel"
                           Text="◐ 100%"
                           Foreground="{DynamicResource AccentForegroundBrush}"
                           FontSize="11"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Margin="10,0,2,0"
                           Cursor="Hand"
                           ToolTip="{Markup:Loc PinnedImage_OpacityTooltip}"
                           MouseLeftButtonUp="OnOpacityLabelClick" />
            </StackPanel>
        </Border>
        <!-- Hover-revealed transport bar: play/pause, seek, timecode, mute. -->
        <Border x:Name="TransportBar"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="8,0,8,8"
                Background="#CC1F1F1F"
                CornerRadius="6"
                Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        x:Name="PlayPauseButton"
                        Width="32" Height="28"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        Content="■"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc ClipboardVideo_PlayPauseTooltip}"
                        Click="OnPlayPauseClick" />
                <Slider Grid.Column="1"
                        x:Name="SeekSlider"
                        Minimum="0"
                        Maximum="1"
                        SmallChange="0.5"
                        LargeChange="5"
                        IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        ValueChanged="OnSeekSliderValueChanged" />
                <TextBlock Grid.Column="2"
                           x:Name="TimeText"
                           Margin="4,0"
                           Foreground="White"
                           FontSize="11"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"
                           Text="00:00 / 00:00" />
                <Button Grid.Column="3"
                        x:Name="MuteButton"
                        Width="32" Height="28"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="12"
                        Content="🔊"
                        Cursor="Hand"
                        ToolTip="{Markup:Loc ClipboardVideo_MuteTooltip}"
                        Click="OnMuteClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
