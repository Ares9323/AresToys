<UserControl x:Class="AresToys.App.Views.PeekSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:Markup="clr-namespace:AresToys.App.Markup"
             xmlns:cv="clr-namespace:AresToys.App.Converters">
    <UserControl.Resources>
        <cv:PathIconConverter x:Key="PathIcon" />
    </UserControl.Resources>
    <!-- Peek section. DataContext is the SettingsViewModel (inherited from MainWindow): the module switch is its
         PeekModuleEnabled, the programs and associations live on its Peek view model. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,16,24,16" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Text="{Markup:Loc Sidebar_Peek}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <!-- Card 1: the module switch. -->
            <Border Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <CheckBox IsChecked="{Binding PeekModuleEnabled, Mode=TwoWay}"
                              Content="{Markup:Loc Settings_ModulePeek}"
                              Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12"
                              HorizontalAlignment="Left" Margin="0,0,0,8"
                              ToolTip="{Markup:Loc Settings_ModulePeekTooltip}" />
                    <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                               Text="{Markup:Loc Peek_Hint}" />

                    <!-- The two keys: shortcut that opens and closes Peek, key that opens the file in its assigned program. -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Markup:Loc Peek_Shortcut}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="{Markup:Loc Peek_ShortcutHint}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"
                                   Text="{Binding Peek.ToggleText}" />
                        <ui:Button Grid.Column="2" Padding="14,4" VerticalAlignment="Center"
                                   Content="{Markup:Loc Peek_Change}"
                                   Command="{Binding Peek.ChangeToggleCommand}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Markup:Loc Peek_OpenKey}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="{Markup:Loc Peek_OpenKeyHint}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"
                                   Text="{Binding Peek.OpenKeyText}" />
                        <ui:Button Grid.Column="2" Padding="14,4" VerticalAlignment="Center"
                                   Content="{Markup:Loc Peek_Change}"
                                   Command="{Binding Peek.ChangeOpenKeyCommand}" />
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Markup:Loc Peek_EditKey}" FontWeight="SemiBold" />
                            <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                                       Text="{Markup:Loc Peek_EditKeyHint}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"
                                   Text="{Binding Peek.EditKeyText}" />
                        <ui:Button Grid.Column="2" Padding="14,4" VerticalAlignment="Center"
                                   Content="{Markup:Loc Peek_Change}"
                                   Command="{Binding Peek.ChangeEditKeyCommand}" />
                    </Grid>
                    <TextBlock Foreground="#E5484D" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{Binding Peek.KeyErrorText}" />

                    <!-- The window: fit it to the image shown (off: it opens at the last size and place used). -->
                    <CheckBox IsChecked="{Binding Peek.FitToContent, Mode=TwoWay}"
                              Content="{Markup:Loc Peek_FitToContent}"
                              Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12"
                              HorizontalAlignment="Left" Margin="0,12,0,4" />
                    <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                               Text="{Markup:Loc Peek_FitToContentHint}" />
                    <!-- Browse: which files of the folder previous and next go through. -->
                    <TextBlock Text="{Markup:Loc Peek_Nav}" FontSize="12" Margin="0,12,0,4" />
                    <ComboBox ItemsSource="{Binding Peek.BrowseChoices}"
                              SelectedValuePath="Mode" DisplayMemberPath="Name"
                              SelectedValue="{Binding Peek.BrowseMode, Mode=TwoWay}"
                              HorizontalAlignment="Left" MinWidth="200" />
                    <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,4,0,0" Text="{Markup:Loc Peek_NavHint}" />
                    <TextBlock Foreground="#E5484D" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{Binding Peek.FitErrorText}" />
                </StackPanel>
            </Border>

            <!-- Card 2: the "Open in" programs. -->
            <Border Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Markup:Loc Peek_ProgramsTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,8" Text="{Markup:Loc Peek_ProgramsHint}" />
                    <ListBox ItemsSource="{Binding Peek.Programs}"
                             SelectedItem="{Binding Peek.SelectedProgram, Mode=TwoWay}"
                             MaxHeight="180" Margin="0,0,0,8"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource PathIcon}">
                                                <Binding Path="Exe" />
                                                <Binding Path="DataContext.Peek.Icons" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource AccentForegroundDarkBrush}">
                                            <Run Text="{Binding Exe, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Args, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:Button Content="{Markup:Loc Peek_Add}" Padding="14,4" Margin="0,0,8,0"
                                   Command="{Binding Peek.AddProgramCommand}" />
                        <ui:Button Content="{Markup:Loc Peek_Edit}" Padding="14,4" Margin="0,0,8,0"
                                   Command="{Binding Peek.EditProgramCommand}" />
                        <ui:Button Content="{Markup:Loc Peek_Remove}" Padding="14,4"
                                   Command="{Binding Peek.RemoveProgramCommand}" />
                    </StackPanel>

                    <!-- Inline editor, shown by Add and Edit. -->
                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding Peek.IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Markup:Loc Peek_Program}" FontSize="11" Margin="0,0,0,2"
                                   Foreground="{DynamicResource AccentForegroundDarkBrush}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Peek.EditExe, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1" Margin="8,0,0,0" Padding="14,4"
                                       Content="{Markup:Loc Peek_Browse}"
                                       Command="{Binding Peek.BrowseProgramCommand}" />
                        </Grid>
                        <TextBlock Text="{Markup:Loc Peek_Name}" FontSize="11" Margin="0,0,0,2"
                                   Foreground="{DynamicResource AccentForegroundDarkBrush}" />
                        <TextBox Text="{Binding Peek.EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                        <TextBlock Text="{Markup:Loc Peek_Arguments}" FontSize="11" Margin="0,0,0,2"
                                   Foreground="{DynamicResource AccentForegroundDarkBrush}" />
                        <TextBox Text="{Binding Peek.EditArgs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,2" />
                        <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,8" Text="{Markup:Loc Peek_ArgumentsHint}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Content="{Markup:Loc Peek_Save}" Padding="14,4" Margin="0,0,8,0"
                                       Appearance="Primary"
                                       Command="{Binding Peek.SaveProgramCommand}" />
                            <ui:Button Content="{Markup:Loc Peek_Cancel}" Padding="14,4"
                                       Command="{Binding Peek.CancelProgramCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: extension to program associations. -->
            <Border Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Markup:Loc Peek_AssociationsTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,8" Text="{Markup:Loc Peek_AssociationsHint}" />
                    <ItemsControl ItemsSource="{Binding Peek.Associations}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Extension}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name"
                                              SelectedValue="{Binding ProgramId, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" />
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="14,4"
                                               Content="{Markup:Loc Peek_Remove}"
                                               Command="{Binding RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Markup:Loc Peek_Extension}" FontSize="11" Margin="0,0,0,2"
                               Foreground="{DynamicResource AccentForegroundDarkBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Peek.NewExtension, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox Grid.Column="1" Margin="8,0,0,0"
                                  ItemsSource="{Binding Peek.ProgramChoices}"
                                  SelectedValuePath="Id" DisplayMemberPath="Name"
                                  SelectedValue="{Binding Peek.NewProgramId, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                        <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="14,4"
                                   Content="{Markup:Loc Peek_Add}"
                                   Command="{Binding Peek.AddAssociationCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 4: the views picked with "Show as" in the footer, one row per extension. -->
            <Border Background="{DynamicResource Surface1Brush}" CornerRadius="4" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{Markup:Loc Peek_FileTypesTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                               Margin="0,0,0,8" Text="{Markup:Loc Peek_FileTypesHint}" />
                    <TextBlock Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" TextWrapping="Wrap"
                               Text="{Markup:Loc Peek_FileTypesEmpty}"
                               Visibility="{Binding Peek.NoFileTypes, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Peek.FileTypes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Extension}" VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding PickName}" VerticalAlignment="Center" />
                                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Padding="14,4"
                                               Content="{Markup:Loc Peek_Remove}"
                                               Command="{Binding RemoveCommand}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Foreground="#E5484D" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="{Binding Peek.FileTypesErrorText}" />
                </StackPanel>
            </Border>

            <TextBlock Foreground="#E5484D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{Binding Peek.ErrorText}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
