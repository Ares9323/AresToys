<ui:FluentWindow x:Class="AresToys.App.Views.VideoTrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:Markup="clr-namespace:AresToys.App.Markup"
        WindowStartupLocation="CenterOwner"
        Title="{Markup:Loc VideoTrim_Title}"
        Width="720" Height="560"
        MinWidth="520" MinHeight="420"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource Surface2Brush}"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource Surface2Brush}"
            BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="2" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- titlebar -->
                <RowDefinition Height="*" />     <!-- player -->
                <RowDefinition Height="Auto" />  <!-- transport -->
                <RowDefinition Height="Auto" />  <!-- in/out + result -->
                <RowDefinition Height="Auto" />  <!-- buttons -->
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType={x:Type ui:FluentWindow}}}">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- ScrubbingEnabled=True (unlike the clipboard preview, which leaves it off): dragging
                 the handles has to show the frame you're landing on, otherwise you're picking cut
                 points blind. It costs a decode per seek, acceptable while this window is open. -->
            <MediaElement Grid.Row="1"
                          x:Name="Player"
                          LoadedBehavior="Manual"
                          UnloadedBehavior="Stop"
                          ScrubbingEnabled="True"
                          Stretch="Uniform"
                          Margin="12,8,12,4"
                          MediaOpened="OnMediaOpened"
                          MediaEnded="OnMediaEnded"
                          MediaFailed="OnMediaFailed"
                          MouseLeftButtonDown="OnSurfaceClick"
                          Cursor="Hand" />

            <!-- Transport + trim timeline. The track shows what survives the cut and what doesn't:
                 the two red bands are the footage being discarded, the lit middle is what's kept,
                 and the two round handles set the cut points by dragging. Clicking anywhere on the
                 track seeks there, so scrubbing and trimming share one strip. -->
            <Grid Grid.Row="2" Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Stop rewinds to the START OF THE TRIM, not of the video: once you've marked an
                     in-point, that's the beginning of the clip you're making. -->
                <Button Grid.Column="0" x:Name="StopButton"
                        Click="OnStopClicked"
                        Width="32" Height="28" Margin="0,0,4,0"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="12" Content="■"
                        ToolTip="{Markup:Loc VideoTrim_StopTooltip}" />
                <Button Grid.Column="1" x:Name="PlayPauseButton"
                        Click="OnPlayPauseClicked"
                        Width="32" Height="28" Margin="0,0,8,0"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        FontSize="12" Content="▶"
                        ToolTip="{Markup:Loc VideoTrim_PlayPauseTooltip}" />

                <!-- Vertical bands, top to bottom: playhead 0–11, track 17–23, handles 13–27. The
                     playhead gets its own lane above the track so it never sits on top of a handle,
                     which made the two impossible to tell apart when they lined up. -->
                <Canvas Grid.Column="2" x:Name="Timeline"
                        Height="34" VerticalAlignment="Center"
                        Background="Transparent"
                        ClipToBounds="False"
                        SizeChanged="OnTimelineSizeChanged"
                        MouseLeftButtonDown="OnTimelineClicked">
                    <!-- Track, drawn bottom-up: base, discarded head, discarded tail, kept span,
                         playhead, then the handles on top so they always take the pointer. -->
                    <Rectangle x:Name="TrackBase" Height="6" Canvas.Top="17"
                               RadiusX="3" RadiusY="3"
                               Fill="{DynamicResource Surface1Brush}" />
                    <Rectangle x:Name="HeadCut" Height="6" Canvas.Top="17"
                               RadiusX="3" RadiusY="3" Fill="#C0392B" Opacity="0.75" />
                    <Rectangle x:Name="TailCut" Height="6" Canvas.Top="17"
                               RadiusX="3" RadiusY="3" Fill="#C0392B" Opacity="0.75" />
                    <Rectangle x:Name="KeepSpan" Height="6" Canvas.Top="17"
                               RadiusX="3" RadiusY="3"
                               Fill="{DynamicResource AccentBackgroundBrush}" />
                    <Rectangle x:Name="Playhead" Width="2" Height="11" Canvas.Top="0"
                               RadiusX="1" RadiusY="1"
                               Fill="White" IsHitTestVisible="False" />

                    <Thumb x:Name="StartHandle"
                           Width="14" Height="14" Canvas.Top="13"
                           DragDelta="OnStartHandleDrag"
                           Cursor="SizeWE"
                           ToolTip="{Markup:Loc VideoTrim_StartHandleTooltip}">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Ellipse Fill="{DynamicResource AccentForegroundBrush}"
                                         Stroke="#C0392B" StrokeThickness="2" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="EndHandle"
                           Width="14" Height="14" Canvas.Top="13"
                           DragDelta="OnEndHandleDrag"
                           Cursor="SizeWE"
                           ToolTip="{Markup:Loc VideoTrim_EndHandleTooltip}">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Ellipse Fill="{DynamicResource AccentForegroundBrush}"
                                         Stroke="#C0392B" StrokeThickness="2" />
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Canvas>

                <TextBlock Grid.Column="3" x:Name="TimecodeText"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11" />
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="12,10,12,0">
                <ui:Button x:Name="SetStartButton" Click="OnSetStartClicked"
                           Content="{Markup:Loc VideoTrim_SetStart}"
                           ToolTip="{Markup:Loc VideoTrim_SetStartTooltip}"
                           Margin="0,0,8,0" />
                <ui:Button x:Name="SetEndButton" Click="OnSetEndClicked"
                           Content="{Markup:Loc VideoTrim_SetEnd}"
                           ToolTip="{Markup:Loc VideoTrim_SetEndTooltip}"
                           Margin="0,0,16,0" />
                <TextBlock x:Name="SelectionText" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12" />
            </StackPanel>

            <Grid Grid.Row="4" Margin="12,12,12,12">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" HorizontalAlignment="Left"
                           Foreground="{DynamicResource AccentForegroundDarkBrush}" FontSize="11"
                           TextWrapping="Wrap" MaxWidth="380" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="TrimButton" Click="OnTrimClicked"
                               Content="{Markup:Loc VideoTrim_Trim}"
                               Appearance="Primary" Width="110" Margin="0,0,8,0" />
                    <ui:Button x:Name="CancelButton" Click="OnCancelClicked"
                               Content="{Markup:Loc VideoTrim_Cancel}" Width="90" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
