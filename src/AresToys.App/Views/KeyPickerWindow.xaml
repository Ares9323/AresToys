<ui:FluentWindow x:Class="AresToys.App.Views.KeyPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:Markup="clr-namespace:AresToys.App.Markup"
        Title="{Markup:Loc KeyPicker_Title}"
        Width="460" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource Surface2Brush}"
        Foreground="{DynamicResource AccentForegroundBrush}">
    <ui:FluentWindow.Resources>
        <!-- Selected is the dark accent, hover the lighter one (same as the editor tool toggles and the sidebar).
             OK is the only Primary button, so it takes the dark accent too. -->
        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{DynamicResource AccentBackgroundLightColor}" />
        <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource AccentBackgroundDarkColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource AccentBackgroundColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource AccentBackgroundColor}" />
        <SolidColorBrush x:Key="AccentControlElevationBorderBrush" Color="{DynamicResource AccentBackgroundDarkColor}" />
        <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="{DynamicResource AccentBackgroundColor}" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2,1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonBackgroundPointerOver}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBackgroundDarkBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Border Background="{DynamicResource Surface2Brush}"
            BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="2" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TitleBar Grid.Row="0" Title="{Markup:Loc KeyPicker_Title}" ShowMaximize="False" ShowMinimize="False">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <Grid Grid.Row="1" Margin="20,8,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Markup:Loc KeyPicker_Modifiers}" FontSize="12"
                           Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,0,6" />
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                    <CheckBox x:Name="CtrlBox" Content="Ctrl" MinWidth="0" />
                    <CheckBox x:Name="ShiftBox" Content="Shift" MinWidth="0" />
                    <CheckBox x:Name="AltBox" Content="Alt" MinWidth="0" />
                    <CheckBox x:Name="WinBox" Content="Win" MinWidth="0" />
                </UniformGrid>

                <TextBlock Grid.Row="2" Text="{Markup:Loc KeyPicker_Key}" FontSize="12"
                           Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,0,6" />
                <Grid Grid.Row="3" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBox x:Name="SearchBox" Grid.Row="0" Height="32" Margin="0,0,0,8"
                                PlaceholderText="{Markup:Loc KeyPicker_Search}" />
                    <ListBox x:Name="KeyList" Grid.Row="1" DisplayMemberPath="Label"
                             Background="{DynamicResource Surface3Brush}"
                             BorderBrush="{DynamicResource InnerBorderBrush}" BorderThickness="1">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="6,8,0,2"
                                                   Foreground="{DynamicResource AccentForegroundDarkBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Grid>

                <Border Grid.Row="4" Padding="12"
                        Background="{DynamicResource Surface3Brush}"
                        BorderBrush="{DynamicResource InnerBorderBrush}" BorderThickness="1" CornerRadius="4">
                    <TextBlock x:Name="ComboPreview" FontFamily="Consolas" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentForegroundBrush}" />
                </Border>

                <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <ui:Button x:Name="OkButton" Content="{Markup:Loc Common_Ok}" Width="96" Height="32"
                               Appearance="Primary" Margin="0,0,8,0" IsDefault="True" />
                    <ui:Button x:Name="CancelButton" Content="{Markup:Loc Common_Cancel}" Width="96" Height="32" IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
