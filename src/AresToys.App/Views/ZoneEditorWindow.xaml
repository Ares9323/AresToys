<!-- Editor for the window snapping layouts. Same FluentWindow chrome as NewWormholeDialog (dark integrated
     title bar, Surface2 background, accent frame). The interactive preview is ZonePreviewCanvas. -->
<ui:FluentWindow x:Class="AresToys.App.Views.ZoneEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:Markup="clr-namespace:AresToys.App.Markup"
        xmlns:local="clr-namespace:AresToys.App.Views"
        WindowStartupLocation="CenterScreen"
        Title="{Markup:Loc WindowSnapping_Title}"
        Width="1020"
        Height="760"
        MinWidth="860"
        MinHeight="620"
        WindowBackdropType="None"
        ExtendsContentIntoTitleBar="True"
        Background="{DynamicResource Surface2Brush}"
        ShowInTaskbar="True">
    <Border Background="{DynamicResource Surface2Brush}"
            BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="2" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ui:TitleBar Grid.Row="0" Title="{Markup:Loc WindowSnapping_Title}">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="pack://application:,,,/Assets/icon.ico" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <Grid Grid.Row="1" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 1. Layout picker and layout level commands -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LayoutBox" Grid.Column="0" DisplayMemberPath="Text" FontSize="13"
                              SelectionChanged="OnLayoutSelectionChanged" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                        <ui:Button x:Name="NewButton" Content="{Markup:Loc WindowSnapping_New}" Padding="12,4" Margin="0,0,6,0"
                                   Click="OnNewClicked" />
                        <ui:Button x:Name="DuplicateButton" Content="{Markup:Loc WindowSnapping_Duplicate}" Padding="12,4" Margin="0,0,6,0"
                                   Click="OnDuplicateClicked" />
                        <ui:Button x:Name="RenameButton" Content="{Markup:Loc WindowSnapping_Rename}" Padding="12,4" Margin="0,0,6,0"
                                   Click="OnRenameClicked" />
                        <ui:Button x:Name="DeleteButton" Content="{Markup:Loc WindowSnapping_Delete}" Padding="12,4"
                                   Click="OnDeleteClicked" />
                    </StackPanel>
                </Grid>

                <!-- 2. Layout settings and monitor -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10" Orientation="Horizontal">
                    <StackPanel Margin="0,0,16,6">
                        <TextBlock Text="{Markup:Loc WindowSnapping_Spacing}" Foreground="{DynamicResource AccentForegroundBrush}"
                                   FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="SpacingBox" Width="150" FontSize="13" KeyDown="OnSettingKeyDown" LostFocus="OnSettingLostFocus" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6">
                        <TextBlock Text="{Markup:Loc WindowSnapping_Sensitivity}" Foreground="{DynamicResource AccentForegroundBrush}"
                                   FontSize="12" Margin="0,0,0,4" />
                        <TextBox x:Name="SensitivityBox" Width="150" FontSize="13" KeyDown="OnSettingKeyDown" LostFocus="OnSettingLostFocus" />
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6">
                        <TextBlock Text="{Markup:Loc WindowSnapping_QuickKey}" Foreground="{DynamicResource AccentForegroundBrush}"
                                   FontSize="12" Margin="0,0,0,4" />
                        <ComboBox x:Name="QuickKeyBox" Width="190" DisplayMemberPath="Text" FontSize="13"
                                  ToolTip="{Markup:Loc WindowSnapping_QuickKeyHint}"
                                  SelectionChanged="OnQuickKeySelectionChanged" />
                    </StackPanel>
                    <TextBlock Text="{Markup:Loc WindowSnapping_QuickKeyHint}" MaxWidth="230" TextWrapping="Wrap" FontSize="11"
                               VerticalAlignment="Bottom" Margin="0,0,16,6"
                               Foreground="{DynamicResource AccentForegroundDarkBrush}" />
                    <StackPanel Margin="0,0,16,6">
                        <TextBlock Text="{Markup:Loc WindowSnapping_UseOn}" Foreground="{DynamicResource AccentForegroundBrush}"
                                   FontSize="12" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="MonitorBox" Width="300" DisplayMemberPath="Text" FontSize="13"
                                      SelectionChanged="OnMonitorSelectionChanged" />
                            <ui:Button x:Name="IdentifyButton" Content="{Markup:Loc WindowSnapping_Identify}" Padding="12,4" Margin="6,0,0,0"
                                       ToolTip="{Markup:Loc WindowSnapping_TipIdentify}" Click="OnIdentifyClicked" />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="UseOnBox" Content="{Markup:Loc WindowSnapping_UseOnThisMonitor}" VerticalAlignment="Bottom"
                              Margin="0,0,0,6" Click="OnUseOnClicked" />
                </WrapPanel>

                <!-- 3. Tools -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <ToggleButton x:Name="SelectToolButton" Content="{Markup:Loc WindowSnapping_ToolSelect}" Padding="14,5" Margin="0,0,6,0"
                                  ToolTip="{Markup:Loc WindowSnapping_TipSelect}" IsChecked="True" Click="OnSelectToolClicked" />
                    <ToggleButton x:Name="SplitToolButton" Content="{Markup:Loc WindowSnapping_ToolSplit}" Padding="14,5" Margin="0,0,6,0"
                                  ToolTip="{Markup:Loc WindowSnapping_TipSplit}" Click="OnSplitToolClicked" />
                    <ui:Button x:Name="SplitAxisButton" Padding="12,4" Margin="0,0,16,0" IsEnabled="False"
                               ToolTip="{Markup:Loc WindowSnapping_TipOrientation}" Click="OnSplitAxisClicked" />
                    <ui:Button x:Name="MergeButton" Content="{Markup:Loc WindowSnapping_Merge}" Padding="12,4" Margin="0,0,16,0"
                               ToolTip="{Markup:Loc WindowSnapping_TipMerge}" Click="OnMergeClicked" />
                    <ui:Button x:Name="UndoButton" Content="{Markup:Loc WindowSnapping_Undo}" Padding="12,4" Margin="0,0,6,0"
                               ToolTip="{Markup:Loc WindowSnapping_TipUndo}" Click="OnUndoClicked" />
                    <ui:Button x:Name="RedoButton" Content="{Markup:Loc WindowSnapping_Redo}" Padding="12,4"
                               ToolTip="{Markup:Loc WindowSnapping_TipRedo}" Click="OnRedoClicked" />
                </StackPanel>

                <!-- 4. Preview -->
                <Border Grid.Row="3" Margin="0,0,0,10" CornerRadius="6" BorderThickness="1"
                        BorderBrush="{DynamicResource OuterBorderBrush}" Background="{DynamicResource Surface1Brush}">
                    <local:ZonePreviewCanvas x:Name="Preview" MinHeight="200" />
                </Border>

                <!-- 5. Selected zone -->
                <StackPanel Grid.Row="4" Margin="0,0,0,4">
                    <TextBlock x:Name="ZoneHeaderText" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="13"
                               FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Markup:Loc WindowSnapping_Left}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="LeftBox" FontSize="13" KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Markup:Loc WindowSnapping_Top}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="TopBox" FontSize="13" KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="{Markup:Loc WindowSnapping_Width}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="WidthBox" FontSize="13" KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="{Markup:Loc WindowSnapping_Height}" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="12" Margin="0,0,0,4" />
                            <TextBox x:Name="HeightBox" FontSize="13" KeyDown="OnFieldKeyDown" LostFocus="OnFieldLostFocus" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="NoteText" Grid.Row="5" MinHeight="18" Margin="0,2,0,8" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentForegroundDarkBrush}" />

                <!-- 6. Footer -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Markup:Loc WindowSnapping_Hint}" VerticalAlignment="Center" FontSize="11"
                               Foreground="{DynamicResource AccentForegroundDarkBrush}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ui:Button x:Name="SaveButton" Content="{Markup:Loc Common_Save}" Padding="14,4" Margin="0,0,8,0"
                                   Appearance="Primary" Click="OnSaveClicked" />
                        <ui:Button x:Name="SaveCopyButton" Content="{Markup:Loc WindowSnapping_SaveAsCopy}" Padding="14,4" Margin="0,0,8,0"
                                   Click="OnSaveCopyClicked" />
                        <ui:Button Content="{Markup:Loc Common_Cancel}" Padding="14,4" IsCancel="True" Click="OnCancelClicked" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
