<ui:FluentWindow x:Class="AresToys.App.Views.FileLocksWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:Markup="clr-namespace:AresToys.App.Markup"
                 Title="{Markup:Loc FileLocks_Title}"
                 Width="860" Height="540"
                 MinWidth="620" MinHeight="380"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource Surface1Brush}"
                 Foreground="{DynamicResource AccentForegroundBrush}">
    <ui:FluentWindow.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
        </Style>
        <Style x:Key="SubduedHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundDarkBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- The plain WPF GridView has no theme here: header, rows and selection are drawn with the app brushes so
             the program list follows the dark and light themes like the rest of the window. -->
        <Style x:Key="LockHeaderStyle" TargetType="GridViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundDarkBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border Background="{DynamicResource Surface3Brush}" BorderBrush="{DynamicResource OuterBorderBrush}"
                                BorderThickness="0,0,1,1" Padding="8,5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LockRowStyle" TargetType="ListViewItem">
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="2,3" Margin="0,1">
                            <GridViewRowPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Surface3Brush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBackgroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8"
            BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Title="{Markup:Loc FileLocks_Title}">
                <ui:TitleBar.Icon>
                    <ui:ImageIcon Source="{StaticResource AresToysLogo}" Margin="0,0,-12,0" />
                </ui:TitleBar.Icon>
            </ui:TitleBar>

            <!-- The item searched and the search state. -->
            <Grid Grid.Row="1" Margin="12,4,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="ItemIcon" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ItemName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ItemPath" FontSize="11" Foreground="{DynamicResource AccentForegroundDarkBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <ui:Button Grid.Column="2" x:Name="RefreshButton" Content="{Markup:Loc FileLocks_Refresh}"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" VerticalAlignment="Center" Click="OnRefreshClicked" />
            </Grid>

            <!-- The programs holding the item, LockHunter style. -->
            <ListView Grid.Row="2" x:Name="ProcessList" Margin="12,0,12,0" SelectionMode="Single"
                      Background="Transparent" BorderBrush="{DynamicResource OuterBorderBrush}" BorderThickness="1"
                      Foreground="{DynamicResource AccentForegroundBrush}"
                      ItemContainerStyle="{StaticResource LockRowStyle}"
                      SelectionChanged="OnProcessSelectionChanged">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{Markup:Loc FileLocks_EndProcess}" Click="OnEndProcessClicked" />
                        <MenuItem Header="{Markup:Loc FileLocks_OpenLocation}" Click="OnOpenLocationClicked" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource LockHeaderStyle}">
                        <GridViewColumn Header="{Markup:Loc FileLocks_ColProcess}" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{Markup:Loc FileLocks_ColPid}" Width="70" DisplayMemberBinding="{Binding ProcessId}" />
                        <GridViewColumn Header="{Markup:Loc FileLocks_ColUser}" Width="140" DisplayMemberBinding="{Binding User}" />
                        <GridViewColumn Header="{Markup:Loc FileLocks_ColPath}" Width="380" DisplayMemberBinding="{Binding ExecutablePath}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <TextBlock Grid.Row="3" Text="{Markup:Loc FileLocks_Details}" Style="{StaticResource SubduedHeader}" Margin="12,10,12,4" />
            <ListBox Grid.Row="4" x:Name="ItemList" Margin="12,0,12,0" />

            <!-- Shown when the list may be missing programs: AresToys is not elevated. -->
            <Border Grid.Row="5" x:Name="PartialBar" Visibility="Collapsed" Margin="12,8,12,0" Padding="10,6"
                    CornerRadius="4" Background="{DynamicResource Surface3Brush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Markup:Loc FileLocks_Partial}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1" x:Name="RestartAdminButton" Margin="10,0,0,0"
                               Content="{Markup:Loc Tray_RestartAsAdmin}" Icon="{ui:SymbolIcon Shield24}"
                               Click="OnRestartAsAdminClicked" />
                </Grid>
            </Border>

            <Border Grid.Row="6" Padding="12,10" CornerRadius="0,0,6,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button x:Name="UnlockButton" Appearance="Primary" Content="{Markup:Loc FileLocks_Unlock}"
                               ToolTip="{Markup:Loc FileLocks_UnlockTooltip}" Margin="0,0,8,0" Click="OnUnlockClicked" />
                    <ui:Button x:Name="DeleteButton" Content="{Markup:Loc FileLocks_Delete}" Margin="0,0,8,0" Click="OnDeleteClicked" />
                    <ui:Button x:Name="OtherButton" Content="{Markup:Loc FileLocks_Other}" Icon="{ui:SymbolIcon ChevronDown24}"
                               Margin="0,0,8,0" Click="OnOtherClicked">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Markup:Loc FileLocks_Rename}" Click="OnRenameClicked" />
                                <MenuItem x:Name="CopyMenuItem" Header="{Markup:Loc FileLocks_Copy}" Click="OnCopyClicked" />
                                <MenuItem Header="{Markup:Loc FileLocks_DeleteAtRestart}" Click="OnDeleteAtRestartClicked" />
                                <Separator />
                                <MenuItem x:Name="EndProcessMenuItem" Header="{Markup:Loc FileLocks_EndProcess}" Click="OnEndProcessClicked" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <ui:Button Content="{Markup:Loc FileLocks_Close}" Width="80" Click="OnCloseClicked" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</ui:FluentWindow>
