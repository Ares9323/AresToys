<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Hosting / DI -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />

    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- WPF UI styling -->
    <PackageVersion Include="WPF-UI" Version="4.0.2" />

    <!-- Tray icon -->
    <PackageVersion Include="H.NotifyIcon.Wpf" Version="2.2.0" />

    <!-- Modern Windows toast notifications (Action Center persistence). UWP-style API surface
         exposed to unpackaged WPF apps via the toolkit's compat layer; the package handles
         AUMID registration so toasts land in Notification Center instead of disappearing
         forever like Win32 balloon tips. Last 7.x release; 8.x moves to CommunityToolkit.WinUI
         which targets WinUI3 specifically. -->
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />

    <!-- Test stack -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />

    <!-- Storage -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <!-- Native SQLite engine binary, pinned above Microsoft.Data.Sqlite 9.0.0's transitive 2.1.10.
         lib.e_sqlite3 2.1.10/2.1.11 embed SQLite < 3.50.2 and carry CVE-2025-6965 (NU1903), which
         our TreatWarningsAsErrors turns into a hard build/publish failure. This is the ONLY
         SQLitePCLRaw package versioned to the embedded SQLite (3.53.3 = SQLite 3.53.3, patched);
         core/provider/bundle keep their own 2.1.x numbering and call the newer binary through the
         stable SQLite C ABI. Transitive pinning (CentralPackageTransitivePinningEnabled, top of
         file) propagates it without touching the Storage / Pipeline project files. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />

    <!-- Capture -->
    <PackageVersion Include="System.Drawing.Common" Version="9.0.0" />

    <!-- Image effects (AresToys.ImageEffects). SkiaSharp does the per-pixel work for the ported
         ShareX adjustment / filter / manipulation chain. 3.x is the GPU-capable line; we don't
         use GPU contexts but the API is otherwise compatible with 2.x ShareX code. -->
    <PackageVersion Include="SkiaSharp" Version="3.116.1" />

    <!-- ONNX Runtime + DirectML EP, used by AresToys.AI for U2NetP background removal. The
         DirectML package brings GPU acceleration on any DX12 GPU (Win10/11); the base
         package is referenced explicitly because some transitive resolutions otherwise
         pin an older version that fails to load alongside DirectML. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.21.0" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.21.0" />

    <!-- QR code generation (used by the QR pipeline task + Show QR window) -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />

    <!-- QR / barcode decoding — pure managed, no System.Drawing dep when fed raw pixels via
         RGBLuminanceSource. Used by the QrReadTask. -->
    <PackageVersion Include="ZXing.Net" Version="0.16.10" />

    <!-- Headless browser used by the webpage-capture pipeline task. The runtime ships with
         Windows 11 / Edge; on Win10 it lazy-installs on first use via the Evergreen runtime. -->
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />

    <!-- Velopack: installer + portable + delta auto-update. Used by AresToys.Updater (runtime
         hooks + UpdateManager) and indirectly by AresToys.App (Main has to call VelopackApp.Run
         before WPF starts so install/uninstall hooks intercept the right way). The CLI tool
         `vpk` is pinned in .config/dotnet-tools.json so CI builds use the same version. -->
    <PackageVersion Include="Velopack" Version="0.0.1053" />
  </ItemGroup>
</Project>
